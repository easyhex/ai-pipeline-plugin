{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bd prime 2>/dev/null || true" },
          { "type": "command", "command": "echo \"Lessons: $(ls .claude/lessons/*.md 2>/dev/null | wc -l | tr -d ' ') | Pipeline: /init /plan-improve /feature /improve /fix /lesson /remember /questionnaire /release\"" }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          { "type": "command", "command": "bd prime 2>/dev/null || true" }
        ]
      }
    ]
  },
  "pipeline": {
    "finish_mode": "merge",
    "default_weight": "standard",
    "visual_verify": {
      "mode": "required",
      "base_url": "http://localhost:3000",
      "dev_command": "auto",
      "dev_port_timeout_sec": 60,
      "fail_on_console_error": true
    }
  },
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true,
    "beads@beads-marketplace": true,
    "template-bridge@template-bridge-marketplace": true,
    "context7-plugin@context7-marketplace": true,
    "ai-pipeline@ai-pipeline-marketplace": true
  }
}
